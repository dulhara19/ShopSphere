FROM node:18-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:18-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_ENABLE_MSW=false
ENV NEXT_PUBLIC_APP_NAME=ShopSphere
ENV NEXT_PUBLIC_ENABLE_USER_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_PRODUCT_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_INVENTORY_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_ORDER_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_PAYMENT_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_SHIPPING_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_REVIEW_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_RECOMMENDATION_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_NOTIFICATION_SERVICE=true
ENV NEXT_PUBLIC_ENABLE_ANALYTICS_SERVICE=true

# Service URLs for Next.js rewrites (baked at build time)
ARG USER_SERVICE_URL=http://localhost:3001
ARG PRODUCT_SERVICE_URL=http://localhost:3002
ARG INVENTORY_SERVICE_URL=http://localhost:3003
ARG ORDER_SERVICE_URL=http://localhost:3004
ARG PAYMENT_SERVICE_URL=http://localhost:3005
ARG SHIPPING_SERVICE_URL=http://localhost:3006
ARG REVIEW_SERVICE_URL=http://localhost:3007
ARG RECOMMENDATION_SERVICE_URL=http://localhost:3008
ARG NOTIFICATION_SERVICE_URL=http://localhost:3009
ARG ANALYTICS_SERVICE_URL=http://localhost:3010

ENV USER_SERVICE_URL=$USER_SERVICE_URL
ENV PRODUCT_SERVICE_URL=$PRODUCT_SERVICE_URL
ENV INVENTORY_SERVICE_URL=$INVENTORY_SERVICE_URL
ENV ORDER_SERVICE_URL=$ORDER_SERVICE_URL
ENV PAYMENT_SERVICE_URL=$PAYMENT_SERVICE_URL
ENV SHIPPING_SERVICE_URL=$SHIPPING_SERVICE_URL
ENV REVIEW_SERVICE_URL=$REVIEW_SERVICE_URL
ENV RECOMMENDATION_SERVICE_URL=$RECOMMENDATION_SERVICE_URL
ENV NOTIFICATION_SERVICE_URL=$NOTIFICATION_SERVICE_URL
ENV ANALYTICS_SERVICE_URL=$ANALYTICS_SERVICE_URL

RUN npm run build

FROM node:18-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
